# =====================================================================
# Empire — Environment variables (development / production)
# Copy this file to .env and fill in real values.
# NEVER commit real secrets to Git. .env is gitignored.
# =====================================================================

# --- Application ---
# Generate with: bin/rails secret (inside the dev container) or `spree rails secret`
SECRET_KEY_BASE=change-me-generate-with-bin-rails-secret

# --- Active Record encryption (Spree encrypts webhook signing keys, gateway
# customer ids, OAuth tokens at rest). Generate with:
#   bin/rails db:encryption:init
# Back these up and NEVER change them once data is encrypted.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Database (Docker Compose sets these itself; only override for non-Docker runs)
# DATABASE_URL=postgres://postgres@localhost:5432/empire_production
# DATABASE_NAME=empire_development
# DATABASE_NAME_TEST=empire_test
# DATABASE_USERNAME=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# --- Web server ---
PORT=3000
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=1

# --- Background jobs (Solid Queue) ---
# SOLID_QUEUE_IN_PUMA=true
# JOB_THREADS=3
# JOB_IMAGE_THREADS=1
# VIPS_CONCURRENCY=1

# --- Job dashboard (Mission Control) HTTP Basic auth (required in production) ---
# MISSION_CONTROL_USER=
# MISSION_CONTROL_PASSWORD=

# --- Docker host ports ---
# SPREE_PORT=3000
# SPREE_DB_PORT=5433
# SPREE_MEILISEARCH_PORT=7700

# --- SSL (true in production by default; false for local dev / non-SSL proxies) ---
# RAILS_FORCE_SSL=false
# RAILS_ASSUME_SSL=false

# --- Public host (used for generated URLs: images, email links) ---
# SPREE_HOST=store.example.com
# CDN_HOST=cdn.example.com

# --- Email (SMTP) ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=store@example.com

# --- File storage (S3-compatible) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=empire-production

# --- Error tracking ---
# SENTRY_DSN=

# --- Search (database by default; uncomment to use Meilisearch) ---
# MEILISEARCH_URL=
# MEILISEARCH_API_KEY=

# --- Market / localization defaults ---
# DEFAULT_MARKET=af
# DEFAULT_CURRENCY=AFN
# DEFAULT_LOCALE=fa-AF
# DEFAULT_TIMEZONE=Asia/Kabul

# --- Payments (set real credentials only after legal review + live gateway test) ---
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# COD_ENABLED=true
# BANK_TRANSFER_ENABLED=true

# --- Storefront (Next.js) ---
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_STORE_URL=http://localhost:3001
# NEXT_PUBLIC_DEFAULT_LOCALE=fa-AF
# NEXT_PUBLIC_DEFAULT_CURRENCY=AFN

# --- Spree CLI (do not change unless you know why) ---
# SPREE_VERSION_TAG=latest
