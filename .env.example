# Local development: copy with `npm run env:bootstrap` (generates random secrets).
# Production: inject real secrets from your secret manager; never use demo values.
COMPOSE_FILE=docker-compose.dev.yml
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
MISSION_CONTROL_USER=empire
MISSION_CONTROL_PASSWORD=
# Public storefront key (not a secret). The seed registers this exact value.
SPREE_PUBLISHABLE_KEY=
# First admin. Demo accounts are enabled only by docker-compose.dev.yml.
ADMIN_EMAIL=admin@empire.test
ADMIN_PASSWORD=
DEMO_SELLER_EMAIL=demo.seller@empire.test
DEMO_SELLER_PASSWORD=DemoSeller123!
DEMO_BUYER_EMAIL=demo.buyer@empire.test
DEMO_BUYER_PASSWORD=DemoBuyer123!
# Host ports; containers always listen on 0.0.0.0 internally.
SPREE_PORT=3000
STOREFRONT_PORT=3001
SPREE_DB_PORT=5433
MAILPIT_UI_PORT=8025
SPREE_HOST=localhost:3000
# Production defaults to HTTPS. Disable both only for a local HTTP smoke test.
RAILS_FORCE_SSL=true
RAILS_ASSUME_SSL=true
# Optional production integrations; no external service is contacted by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SENTRY_DSN=
MEILISEARCH_URL=
CDN_HOST=
